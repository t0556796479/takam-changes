# Copy to .env and adjust. Never commit .env (it is in .gitignore).

# Database. Default: a local SQLite file. For PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg://takam:takam@localhost:5432/takam
DATABASE_URL=sqlite:///./takam.db

# AI provider: "none" (rule-based only, no key needed) or "anthropic".
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
